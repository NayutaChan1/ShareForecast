# ─────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=market
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=market_sentiment
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────
# RabbitMQ
# ─────────────────────────────────────────────────────────────
RABBITMQ_USER=market
RABBITMQ_PASSWORD=change_me_in_production
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ─────────────────────────────────────────────────────────────
# api-gateway (NestJS)
# ─────────────────────────────────────────────────────────────
API_PORT=3000
# Comma-separated origins allowed to call the API / open a WebSocket.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# How often (ms) the gateway pulls fresh prices from Binance.
PRICE_POLL_INTERVAL_MS=5000
# Redis TTL (seconds) for cached real-time prices.
PRICE_CACHE_TTL=30
# Binance public market-data host. The default needs no API key and stays
# reachable where the trading host (api.binance.com) is blocked or throttled.
BINANCE_API_URL=https://data-api.binance.vision/api/v3

# ─────────────────────────────────────────────────────────────
# nlp-engine (Python / FastAPI)
# ─────────────────────────────────────────────────────────────
NLP_PORT=8000
# HuggingFace model used for sentiment inference.
FINBERT_MODEL=ProsusAI/finbert
# Torch device: cpu | cuda
FINBERT_DEVICE=cpu
# Minutes between RSS scrape passes.
SCRAPE_INTERVAL_MINUTES=10
# Max articles pulled per feed per pass.
SCRAPE_MAX_ITEMS=25
# Where HuggingFace caches model weights inside the container.
HF_HOME=/models

# ─────────────────────────────────────────────────────────────
# frontend (Vue 3)
# ─────────────────────────────────────────────────────────────
# Base URL the browser uses to reach api-gateway.
VITE_API_BASE_URL=http://localhost:3000
# Socket.IO negotiates over HTTP before upgrading, so this is http(s), not ws(s).
VITE_WS_URL=http://localhost:3000
FRONTEND_PORT=8080
