# ═══════════════════════════════════════════════════════════════
#  KONFIGURASI PRODUKSI
#
#  Salin ke .env di server, lalu isi setiap baris bertanda [GANTI].
#  Baris tanpa tanda itu sudah aman dibiarkan apa adanya.
#
#      cp .env.production.example .env
#
#  JANGAN commit file .env — sudah masuk .gitignore.
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# [GANTI] Domain & TLS
# ───────────────────────────────────────────────────────────────
# Domain tempat dashboard diakses. A record-nya HARUS sudah mengarah
# ke IP server ini sebelum stack dinyalakan — Caddy memverifikasi
# kepemilikan domain lewat HTTP sebelum menerbitkan sertifikat.
DOMAIN=saham.example.com

# Email untuk Let's Encrypt (notifikasi kedaluwarsa sertifikat).
ACME_EMAIL=anda@example.com

# ───────────────────────────────────────────────────────────────
# [GANTI] Kredensial — WAJIB, jangan pakai nilai contoh
# ───────────────────────────────────────────────────────────────
# Buat yang acak, jangan diketik manual:
#   openssl rand -base64 24
POSTGRES_PASSWORD=ISI_DENGAN_HASIL_openssl_rand
RABBITMQ_PASSWORD=ISI_DENGAN_HASIL_openssl_rand_YANG_BERBEDA

# ───────────────────────────────────────────────────────────────
# Database — aman dibiarkan
# ───────────────────────────────────────────────────────────────
POSTGRES_USER=market
POSTGRES_DB=market_sentiment
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ───────────────────────────────────────────────────────────────
# Redis & RabbitMQ — aman dibiarkan
# ───────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_USER=market
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ───────────────────────────────────────────────────────────────
# API gateway — aman dibiarkan
# ───────────────────────────────────────────────────────────────
API_PORT=3000
# Dioverride otomatis oleh docker-compose.prod.yml menjadi https://$DOMAIN.
CORS_ORIGINS=https://saham.example.com
BINANCE_API_URL=https://data-api.binance.vision/api/v3

# Interval polling harga. Naikkan ke 15000 kalau ingin lebih hemat
# kuota API dan CPU; dashboard tetap terasa real-time.
PRICE_POLL_INTERVAL_MS=10000
PRICE_CACHE_TTL=30

# ───────────────────────────────────────────────────────────────
# NLP engine — aman dibiarkan
# ───────────────────────────────────────────────────────────────
NLP_PORT=8000
FINBERT_MODEL=ProsusAI/finbert
FINBERT_DEVICE=cpu
TORCH_THREADS=2
SCRAPE_INTERVAL_MINUTES=10
SCRAPE_MAX_ITEMS=25
HF_HOME=/models

# ───────────────────────────────────────────────────────────────
# Frontend
# ───────────────────────────────────────────────────────────────
# Sengaja dikosongkan: di produksi Caddy menyajikan frontend dan API
# pada satu domain, jadi request-nya relatif (same-origin) dan tidak
# ada CORS sama sekali. docker-compose.prod.yml sudah memaksa ini.
VITE_API_BASE_URL=
VITE_WS_URL=

# ───────────────────────────────────────────────────────────────
# Batas memori — sesuaikan dengan RAM server
# ───────────────────────────────────────────────────────────────
# Nilai di bawah pas untuk VPS 4 GB (stack idle ~1.2 GB, puncak ~2.3 GB).
# Untuk VPS 8 GB boleh dinaikkan, tapi tidak wajib.
NLP_WORKER_MEM_LIMIT=2g
NLP_ENGINE_MEM_LIMIT=1g
SCRAPER_MEM_LIMIT=256m
API_MEM_LIMIT=512m
POSTGRES_MEM_LIMIT=512m
RABBITMQ_MEM_LIMIT=512m
